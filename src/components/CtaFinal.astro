---
/** Llamado a la acción que cierra casi todas las páginas. */
import sitio from "../datos/sitio.json";
import inicio from "../datos/inicio.json";
interface Props { titulo: string; texto: string; }
const { titulo, texto } = Astro.props;
const wa = `https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent("Hola, quisiera cotizar un proyecto con Hugo Franco Ingeniería.")}`;
const [a1, a2] = inicio.ctaFinal.acciones;
---
<section class="pad">
  <div class="container">
    <div class="cta-final">
      <h2>{titulo}</h2>
      <p>{texto}</p>
      <div class="acciones">
        <a href={wa} class="btn btn-lima" target="_blank" rel="noopener">
          {a1.texto}<span class="chip"><i data-lucide="message-circle"></i></span>
        </a>
        <a href={a2.href} class="btn btn-linea">{a2.texto}</a>
      </div>
    </div>
  </div>
</section>
