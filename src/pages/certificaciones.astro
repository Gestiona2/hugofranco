---
import Layout from "../layouts/Layout.astro";
import EncabezadoPagina from "../components/EncabezadoPagina.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Protocolo from "../components/Protocolo.astro";
import d from "../datos/certificaciones.json";
---

<Layout titulo={d.seo.titulo} descripcion={d.seo.descripcion} activa="certificaciones">
  <EncabezadoPagina titulo={d.encabezado.titulo} texto={d.encabezado.texto} imagen={d.encabezado.imagen} alt={d.encabezado.alt} />

  <section class="pad" style="padding-top:clamp(36px,5vw,64px)">
    <div class="container">
      <div class="marcos">
        {d.marcos.map((m) => (
          <article class="marco">
            <span class="sigla">{m.sigla}</span>
            <h3>{m.titulo}</h3>
            <p>{m.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pad cianotipo">
    <div class="container">
      <div class="protocolo-cab">
        <div>
          <span class="rotulo">{d.servicio.eyebrow}</span>
          <h2 class="titulo-seccion" style="margin-top:18px">{d.servicio.titulo}</h2>
        </div>
        <p>{d.servicio.texto}</p>
      </div>
      <Protocolo pasos={d.servicio.pasos} etiqueta={d.servicio.titulo} />
    </div>
  </section>

  <section class="pad">
    <div class="container" style="max-width:760px">
      <h2 class="titulo-seccion">{d.documentos.titulo}</h2>
      <p class="lead" style="margin-top:20px">{d.documentos.texto}</p>
      <a href={d.documentos.cta.href} class="btn btn-primario" style="margin-top:30px">
        {d.documentos.cta.texto}<span class="chip"><i data-lucide="arrow-right"></i></span>
      </a>
    </div>
  </section>

  <CtaFinal titulo={d.cta.titulo} texto={d.cta.texto} />
</Layout>
