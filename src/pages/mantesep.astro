---
import Layout from "../layouts/Layout.astro";
import EncabezadoPagina from "../components/EncabezadoPagina.astro";
import CtaFinal from "../components/CtaFinal.astro";
import d from "../datos/mantesep.json";
---

<Layout titulo={d.seo.titulo} descripcion={d.seo.descripcion} activa="mantesep">
  <EncabezadoPagina titulo={d.encabezado.titulo} texto={d.encabezado.texto} imagen={d.encabezado.imagen} alt={d.encabezado.alt} />

  <section class="pad">
    <div class="container">
      <span class="rotulo">{d.lista.eyebrow}</span>
      <h2 class="titulo-seccion" style="margin:18px 0 44px">{d.lista.titulo}</h2>

      <div class="m-servicios">
        {d.servicios.map((s) => (
          <article class="m-servicio">
            <img src={s.imagen} alt={s.alt} width="800" height="600" loading="lazy" />
            <div class="cuerpo">
              <div class="ico"><i data-lucide={s.icono}></i></div>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="pad cianotipo">
    <div class="container" style="max-width:860px">
      <span class="rotulo">{d.certificacion.eyebrow}</span>
      <h2 class="titulo-seccion" style="margin-top:18px;max-width:20ch">{d.certificacion.titulo}</h2>
      <p class="lead" style="margin-top:22px">{d.certificacion.texto}</p>
      <div style="margin-top:32px">
        <a href="/certificaciones" class="btn btn-lima">{d.certificacion.cta}<span class="chip"><i data-lucide="arrow-right"></i></span></a>
      </div>
    </div>
  </section>

  <CtaFinal titulo={d.cta.titulo} texto={d.cta.texto} />
</Layout>
