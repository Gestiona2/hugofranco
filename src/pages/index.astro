---
/**
 * Inicio — "el plano certificado".
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/*.json.
 */
import Layout from "../layouts/Layout.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Protocolo from "../components/Protocolo.astro";
import sitio from "../datos/sitio.json";
import d from "../datos/inicio.json";
import servicios from "../datos/servicios.json";
import certificaciones from "../datos/certificaciones.json";
import proyectos from "../datos/proyectos.json";

const logos = [...d.clientes.logos, ...d.clientes.logos]; // duplicados: la cinta se repite sin corte
const p = d.hero.prueba;

/* Geometría de la curva de prueba (viewBox 560 × 270) */
const X0 = 52, X1 = 540, Y0 = 224, Y200 = 44;
const yPsi = (psi: number) => Y0 - (psi / 200) * (Y0 - Y200);
const yTicks = [0, 50, 100, 150, 200];
const xTicks = p.ejeX.map((t, i) => ({ t, x: X0 + (i * (X1 - X0)) / (p.ejeX.length - 1) }));
const curva = `M${X0} ${Y0} L74 ${Y0} C88 ${Y0}, 90 36, 112 36 C124 36, 128 ${Y200}, 144 ${Y200} L${X1} ${Y200}`;
const area = `${curva} L${X1} ${Y0} L${X0} ${Y0} Z`;

/* Obras: una tarjeta por proyecto, con su primera foto y cuántas fotos tiene */
const obras = proyectos.filtros
  .filter((f) => f.id !== "todo")
  .map((f) => {
    const fotos = proyectos.items.filter((i) => i.cliente === f.id);
    return { id: f.id, nombre: f.texto, descripcion: fotos[0].descripcion, src: fotos[0].src, alt: fotos[0].alt, total: fotos.length };
  });

const frenteAria = servicios.lista.map((s) => s.titulo).join(", ");
---

<Layout titulo={d.seo.titulo} descripcion={d.seo.descripcion} activa="inicio">
  <!-- ==================== PORTADA ==================== -->
  <header class="portada hoja">
    <div class="container">
      <div class="portada-grid">
        <div>
          <span class="rotulo">{d.hero.eyebrow}</span>
          <h1>{d.hero.titulo}</h1>
          <p class="lead">{d.hero.sub}</p>
          <div class="portada-acciones">
            {d.hero.acciones.map((a) => (
              <a href={a.href} class={`btn ${a.estilo}`}>
                {a.texto}
                {a.icono && <span class="chip"><i data-lucide={a.icono}></i></span>}
              </a>
            ))}
          </div>
          <div class="portada-datos">
            {d.hero.datos.map((x) => (
              <div><strong>{x.cifra}</strong><small>{x.texto}</small></div>
            ))}
          </div>
        </div>

        <!-- El momento memorable: la prueba hidrostática -->
        <figure class="prueba esquinas" id="prueba" role="img" aria-label={`${p.titulo}: ${p.pie}`}>
          <div class="prueba-cab">
            <div>
              <h2>{p.titulo}</h2>
              <p>{p.subtitulo}</p>
            </div>
            <div class="prueba-lectura" aria-hidden="true">
              <div><span>{p.presion}</span><b class="psi"><i id="pruebaPsi" style="font-style:normal">0</i> <small>{p.unidad}</small></b></div>
              <div><span>{p.tiempo}</span><b id="pruebaTiempo">0:00:00</b></div>
            </div>
          </div>

          <svg viewBox="0 0 560 270" aria-hidden="true" focusable="false">
            <defs>
              <clipPath id="recorteArea"><rect id="recorteRect" x={X0} y="0" width="0" height="270"></rect></clipPath>
            </defs>
            {yTicks.map((v) => (
              <>
                <line class="malla" x1={X0} x2={X1} y1={yPsi(v)} y2={yPsi(v)}></line>
                <text class="marca-y" x={X0 - 10} y={yPsi(v) + 4} text-anchor="end">{v}</text>
              </>
            ))}
            {xTicks.map((t) => (
              <>
                <line class="malla" x1={t.x} x2={t.x} y1={Y200 - 8} y2={Y0}></line>
                <text class="marca-x" x={t.x} y={Y0 + 22} text-anchor={t.x === X0 ? "start" : t.x === X1 ? "end" : "middle"}>{t.t}</text>
              </>
            ))}
            <line class="eje" x1={X0} x2={X1} y1={Y0} y2={Y0}></line>
            <line class="eje" x1={X0} x2={X0} y1={Y200 - 8} y2={Y0}></line>
            <line class="ref" x1={X0} x2={X1} y1={Y200} y2={Y200}></line>
            <text class="ref-texto" x={X1} y={Y200 - 9} text-anchor="end">{p.referencia}</text>
            <path class="area" d={area} clip-path="url(#recorteArea)"></path>
            <path class="curva" id="curva" d={curva}></path>
            <circle class="punto" id="punto" r="6" cx={X0} cy={Y0}></circle>
          </svg>

          <div class="prueba-pie">
            <small>{p.pie}</small>
          </div>

          <div class="sello" id="sello" aria-hidden="true">
            <div><i data-lucide="badge-check"></i><b>{p.sello.titulo}</b><span>{p.sello.sub}</span></div>
          </div>
        </figure>
      </div>

      <!-- Lámina: la red, con sus partes numeradas -->
      <div class="lamina">
        <div class="lamina-marco esquinas">
          <img src={d.hero.lamina.imagen} alt={d.hero.lamina.alt} width="1905" height="705" loading="eager" fetchpriority="high" />
          {d.hero.lamina.marcadores.map((m) => (
            <span class="marcador" style={`left:${m.x}%;top:${m.y}%`} aria-hidden="true">{m.n}</span>
          ))}
        </div>
        <div class="lamina-leyenda">
          {d.hero.lamina.leyenda.map((l) => (
            <div>
              <span class="n">{l.n}</span>
              <strong>{l.titulo}</strong>
              <p>{l.texto}</p>
            </div>
          ))}
        </div>
        <div class="lamina-pie"><span>{d.hero.lamina.pie[0]}</span><span>{d.hero.lamina.pie[1]}</span></div>
      </div>
    </div>
  </header>

  <!-- ==================== CLIENTES ==================== -->
  <section class="clientes" aria-label={d.clientes.titulo}>
    <p>{d.clientes.titulo}</p>
    <div class="cinta">
      <div class="cinta-pista">
        {logos.map((l, i) => <img src={l.src} alt={i < d.clientes.logos.length ? l.alt : ""} height="56" loading="lazy" aria-hidden={i >= d.clientes.logos.length ? "true" : undefined} />)}
      </div>
    </div>
  </section>

  <!-- ==================== NOSOTROS ==================== -->
  <section class="pad" id="nosotros">
    <div class="container nosotros">
      <div>
        <span class="rotulo">{d.nosotros.eyebrow}</span>
        <h2 class="titulo-seccion" style="margin-top:18px">{d.nosotros.titulo}</h2>
        <div style="margin-top:26px">
          {d.nosotros.parrafos.map((t) => <p class="lead">{t}</p>)}
        </div>
        <ul class="especificacion">
          {d.nosotros.puntos.map((t) => (
            <li><i data-lucide="check-circle-2"></i><span>{t}</span></li>
          ))}
        </ul>
        <a href={d.nosotros.cta.href} class="btn btn-primario" style="margin-top:34px">
          {d.nosotros.cta.texto}<span class="chip"><i data-lucide="arrow-right"></i></span>
        </a>
      </div>
      <div class="nosotros-fotos">
        {d.nosotros.fotos.map((f) => (
          <figure class="esquinas"><img src={f.src} alt={f.alt} width="900" height="1200" loading="lazy" /></figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== FRENTES ==================== -->
  <section class="pad frentes-fondo" id="servicios">
    <div class="container frentes">
      <div class="frentes-indice">
        <span class="rotulo">{d.servicios.eyebrow}</span>
        <h2 class="titulo-seccion" style="margin-top:18px">{d.servicios.titulo}</h2>
        <p class="lead">{d.servicios.intro}</p>
        <ul class="frentes-lista" aria-label={d.servicios.indiceTitulo}>
          {servicios.lista.map((s) => (
            <li class={`l-${s.linea}`}>
              <a href={`#f-${s.id}`} data-frente={`f-${s.id}`}>
                <span class="n">{s.num}</span><span>{s.titulo}</span><span class="t"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="frentes-paneles">
        {servicios.lista.map((s) => (
          <article class={`frente l-${s.linea}`} id={`f-${s.id}`}>
            <div class="frente-tuberia" aria-hidden="true"></div>
            <div class="frente-foto"><img src={s.imagen} alt={s.alt} width="1000" height="500" loading="lazy" /></div>
            <div class="frente-cuerpo">
              <div class="frente-cab">
                <span class="ico"><i data-lucide={s.icono}></i></span>
                <span class="n">{s.num}</span>
              </div>
              <h3>{s.titulo}</h3>
              <p>{s.texto}</p>
              <ul class="etiquetas">{s.tags.map((t) => <li>{t}</li>)}</ul>
              <a href={`/servicios#${s.id}`} class="enlace-flecha">{d.servicios.cta}<i data-lucide="arrow-up-right"></i></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CERTIFICACIÓN: el protocolo ==================== -->
  <section class="pad cianotipo" id="certificacion">
    <div class="container">
      <div class="protocolo-cab">
        <div>
          <span class="rotulo">{d.certificacion.eyebrow}</span>
          <h2 class="titulo-seccion" style="margin-top:18px">{d.certificacion.titulo}</h2>
        </div>
        <div>
          {d.certificacion.parrafos.map((t) => <p>{t}</p>)}
        </div>
      </div>

      <Protocolo pasos={certificaciones.servicio.pasos} etiqueta={d.certificacion.pasosTitulo} />

      <div class="protocolo-cierre">
        <a href={d.certificacion.cta.href} class="btn btn-lima">
          {d.certificacion.cta.texto}<span class="chip"><i data-lucide="arrow-right"></i></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== OBRA CONSTRUIDA ==================== -->
  <section class="pad" id="obra">
    <div class="container">
      <div class="obra-cab">
        <div>
          <span class="rotulo">{d.obra.eyebrow}</span>
          <h2 class="titulo-seccion" style="margin-top:18px;max-width:22ch">{d.obra.titulo}</h2>
          <p class="lead" style="margin-top:18px">{d.obra.texto}</p>
        </div>
        <a href="/proyectos" class="btn btn-linea">{d.obra.cta}</a>
      </div>
      <div class="riel" tabindex="0" role="group" aria-label={d.obra.titulo}>
        {obras.map((o) => (
          <a href="/proyectos" class="obra">
            <img src={o.src} alt={o.alt} width="800" height="600" loading="lazy" />
            <div class="obra-cuerpo">
              <strong>{o.nombre}</strong>
              <span>{o.descripcion}</span>
              <em>{o.total} {d.obra.fotosEtiqueta}</em>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== MANTESEP ==================== -->
  <section class="pad mantesep-fondo">
    <div class="container">
      <div class="mantesep-cab">
        <div>
          <span class="rotulo">{d.mantesep.eyebrow}</span>
          <h2 class="titulo-seccion" style="margin-top:18px">{d.mantesep.titulo}</h2>
        </div>
        <p class="lead">{d.mantesep.texto}</p>
      </div>
      <div class="mantesep-grid">
        {d.mantesep.items.map((x) => (
          <a href="/mantesep" class="m-tarjeta">
            <img src={x.img} alt="" width="800" height="600" loading="lazy" />
            <h3>{x.t}<i data-lucide="arrow-up-right"></i></h3>
          </a>
        ))}
      </div>
      <div style="margin-top:34px">
        <a href="/mantesep" class="btn btn-primario">{d.mantesep.cta}<span class="chip"><i data-lucide="arrow-right"></i></span></a>
      </div>
    </div>
  </section>

  <!-- ==================== TESTIMONIO ==================== -->
  <section class="pad">
    <div class="container">
      <figure class="cita">
        <div class="comillas" aria-hidden="true">&ldquo;</div>
        <div>
          <blockquote>{d.testimonio.texto}</blockquote>
          <footer><strong>{d.testimonio.autor}</strong></footer>
        </div>
      </figure>
    </div>
  </section>

  <CtaFinal titulo={d.ctaFinal.titulo} texto={d.ctaFinal.texto} />
</Layout>

<script is:inline define:vars={{ X0, X1, Y0, Y200 }}>
  (function () {
    const menos = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const $ = (s) => document.querySelector(s);

    /* ---------- La prueba hidrostática ---------- */
    const caja = $("#prueba"), curva = $("#curva"), punto = $("#punto"), clip = $("#recorteRect");
    const lecPsi = $("#pruebaPsi"), lecT = $("#pruebaTiempo"), sello = $("#sello");
    if (caja && curva) {
      const L = curva.getTotalLength();
      // Tabla x → longitud, para que la animación avance con el tiempo y no con la longitud del trazo
      const tabla = [];
      for (let i = 0; i <= 400; i++) { const pt = curva.getPointAtLength((i / 400) * L); tabla.push([pt.x, (i / 400) * L]); }
      const longEn = (x) => { for (let i = 1; i < tabla.length; i++) if (tabla[i][0] >= x) return tabla[i][1]; return L; };
      curva.style.strokeDasharray = L;

      const pintar = (p) => {
        const x = X0 + p * (X1 - X0);
        const len = longEn(x);
        const pt = curva.getPointAtLength(len);
        curva.style.strokeDashoffset = L - len;
        punto.setAttribute("cx", pt.x); punto.setAttribute("cy", pt.y);
        clip.setAttribute("width", Math.max(0, x - X0));
        lecPsi.textContent = Math.max(0, Math.round(((Y0 - pt.y) / (Y0 - Y200)) * 200));
        const seg = Math.round(p * 7200);
        lecT.textContent = Math.floor(seg / 3600) + ":" + String(Math.floor((seg % 3600) / 60)).padStart(2, "0") + ":" + String(seg % 60).padStart(2, "0");
      };
      const terminar = () => { pintar(1); caja.dataset.listo = "1"; sello.classList.add("puesto"); };

      if (menos) { terminar(); }
      else {
        pintar(0);
        const DUR = 4600;
        const correr = () => {
          const t0 = performance.now() + 500;
          const paso = (ahora) => {
            const t = Math.min(Math.max((ahora - t0) / DUR, 0), 1);
            pintar(t);
            if (t < 1) requestAnimationFrame(paso); else terminar();
          };
          requestAnimationFrame(paso);
        };
        if ("IntersectionObserver" in window) {
          const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { io.disconnect(); correr(); } }, { threshold: 0.45 });
          io.observe(caja);
        } else correr();
      }
    }

    /* ---------- Índice de frentes (scroll fijo) ---------- */
    const enlaces = [...document.querySelectorAll("[data-frente]")];
    const paneles = enlaces.map((a) => document.getElementById(a.dataset.frente));
    if (enlaces.length && "IntersectionObserver" in window) {
      const ioF = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) enlaces.forEach((a) => a.classList.toggle("activo", a.dataset.frente === e.target.id)); });
      }, { rootMargin: "-35% 0px -55% 0px" });
      paneles.forEach((p) => p && ioF.observe(p));
    }

  })();
</script>
