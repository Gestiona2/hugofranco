---
import Layout from "../layouts/Layout.astro";
import EncabezadoPagina from "../components/EncabezadoPagina.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Protocolo from "../components/Protocolo.astro";
import d from "../datos/servicios.json";
---

<Layout titulo={d.seo.titulo} descripcion={d.seo.descripcion} activa="servicios">
  <EncabezadoPagina titulo={d.encabezado.titulo} texto={d.encabezado.texto} imagen={d.encabezado.imagen} alt={d.encabezado.alt} />

  <section class="pad" style="padding-top:clamp(36px,5vw,64px)">
    <div class="container">
      {d.lista.map((s) => (
        <article class={`servicio-pagina l-${s.linea}`} id={s.id}>
          <div class="sp-grid">
            <div>
              <div class="frente-cab">
                <span class="ico"><i data-lucide={s.icono}></i></span>
                <span class="n">{s.num}</span>
              </div>
              <h2>{s.titulo}</h2>
              <p class="resumen">{s.resumen}</p>
              <ul class="etiquetas">{s.tags.map((t) => <li>{t}</li>)}</ul>
            </div>
            <div>
              <p class="lead">{s.texto}</p>
              <div class="foto esquinas"><img src={s.imagen} alt={s.alt} width="1000" height="560" loading="lazy" /></div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="pad cianotipo">
    <div class="container">
      <span class="rotulo">{d.proceso.eyebrow}</span>
      <h2 class="titulo-seccion" style="margin-top:18px">{d.proceso.titulo}</h2>
      <div style="margin-top:8px">
        <Protocolo pasos={d.proceso.pasos} etiqueta={d.proceso.titulo} />
      </div>
    </div>
  </section>

  <CtaFinal titulo={d.cta.titulo} texto={d.cta.texto} />
</Layout>
